generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "relationJoins", "views"]
}

datasource db {
  provider   = "postgresql"
  extensions = [unaccent]
  schemas    = ["academic", "ai", "auth", "infraestructure", "inventory", "public"]
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
  @@schema("auth")
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  name                     String
  email                    String?                   @unique
  code                     String                    @unique
  hash                     String
  hashedRt                 String?
  activeStatus             Boolean                   @default(true)
  teacher                  Teacher?
  resetPasswordTokens      ResetPasswordToken[]
  userRoles                UserRole[]
  scheduleComplianceChecks ScheduleComplianceCheck[]

  @@map("users")
  @@schema("auth")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])
  User   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("auth")
}

model Teacher {
  id                  String                       @id @default(uuid()) @db.Uuid
  categoryId          String                       @db.Uuid
  contractTypeId      String                       @db.Uuid
  shiftId             String                       @db.Uuid
  userId              String                       @unique @db.Uuid
  shiftEnd            DateTime?                    @db.Time(6)
  shiftStart          DateTime?                    @db.Time(6)
  academicReports     AcademicAssignmentReport[]
  positionHeld        TeacherDepartmentPosition[]
  postgraduateDegrees TeacherPostgraduateDegree[]
  undergradDegrees    TeacherUndergraduateDegree[]
  category            TeacherCategory              @relation(fields: [categoryId], references: [id])
  contractType        ContractType                 @relation(fields: [contractTypeId], references: [id])
  shift               Shift                        @relation(fields: [shiftId], references: [id])
  user                User                         @relation(fields: [userId], references: [id])
  preferredClasses    TeacherPreferredClass[]

  @@map("teachers")
  @@schema("academic")
}

model UndergraduateDegree {
  id                   String                       @id @default(uuid()) @db.Uuid
  name                 String                       @unique
  undergraduateDegrees TeacherUndergraduateDegree[]

  @@map("undergraduate_degrees")
  @@schema("academic")
}

model PostgraduateDegree {
  id                  String                      @id @default(uuid()) @db.Uuid
  name                String                      @unique
  postgraduateDegrees TeacherPostgraduateDegree[]

  @@map("postgraduate_degrees")
  @@schema("academic")
}

model TeacherUndergraduateDegree {
  teacherId       String              @db.Uuid
  undergraduateId String              @db.Uuid
  teacher         Teacher             @relation(fields: [teacherId], references: [id])
  undergraduate   UndergraduateDegree @relation(fields: [undergraduateId], references: [id])

  @@id([teacherId, undergraduateId])
  @@map("teacher_undergraduate_degrees")
  @@schema("academic")
}

model TeacherPostgraduateDegree {
  teacherId      String             @db.Uuid
  postgraduateId String             @db.Uuid
  postgraduate   PostgraduateDegree @relation(fields: [postgraduateId], references: [id])
  teacher        Teacher            @relation(fields: [teacherId], references: [id])

  @@id([teacherId, postgraduateId])
  @@map("teacher_postgraduate_degrees")
  @@schema("academic")
}

model TeacherCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String
  teachers    Teacher[]

  @@map("teacher_categories")
  @@schema("academic")
}

model ContractType {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  teachers Teacher[]

  @@map("contract_types")
  @@schema("academic")
}

model Shift {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  teachers Teacher[]

  @@map("shifts")
  @@schema("academic")
}

model Center {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  departments CenterDepartment[]
  buildings   Building[]

  @@map("centers")
  @@schema("academic")
}

model Faculty {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  departments Department[]

  @@map("faculties")
  @@schema("academic")
}

model Department {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique
  uvs                  Int?
  facultyId            String                @db.Uuid
  centers              CenterDepartment[]
  courses              Course[]
  faculty              Faculty               @relation(fields: [facultyId], references: [id])
  departmentClassrooms ClassroomDepartment[]

  @@map("departments")
  @@schema("academic")
}

model Course {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String
  code                  String                  @unique
  uvs                   Int
  departmentId          String                  @db.Uuid
  activeStatus          Boolean                 @default(true)
  courseClassroom       CourseClassroom[]
  department            Department              @relation(fields: [departmentId], references: [id])
  teacherPreferredClass TeacherPreferredClass[]

  @@map("courses")
  @@schema("academic")
}

model TeacherDepartmentPosition {
  id                 String           @id @default(uuid()) @db.Uuid
  teacherId          String           @db.Uuid
  positionId         String           @db.Uuid
  startDate          DateTime         @default(now())
  endDate            DateTime?
  centerDepartmentId String           @db.Uuid
  centerDepartment   CenterDepartment @relation(fields: [centerDepartmentId], references: [id])
  position           Position         @relation(fields: [positionId], references: [id])
  teacher            Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, centerDepartmentId])
  @@map("teacher_department_position")
  @@schema("academic")
}

model CenterDepartment {
  centerId            String                      @db.Uuid
  departmentId        String                      @db.Uuid
  id                  String                      @id @default(uuid()) @db.Uuid
  academicReports     AcademicAssignmentReport[]
  center              Center                      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  department          Department                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacherAppointments TeacherDepartmentPosition[]

  @@unique([centerId, departmentId])
  @@map("center_departments")
  @@schema("academic")
}

model Position {
  id           String                      @id @default(uuid()) @db.Uuid
  name         String                      @unique
  appointments TeacherDepartmentPosition[]

  @@map("positions")
  @@schema("academic")
}

model Building {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  color      String?
  floors     String?
  centerId   String      @db.Uuid
  center     Center      @relation(fields: [centerId], references: [id])
  classrooms Classroom[]

  @@map("buildings")
  @@schema("infraestructure")
}

model DigitalBlackboard {
  id            String      @id @default(uuid()) @db.Uuid
  description   String?
  brandId       String      @db.Uuid
  monitorTypeId String      @db.Uuid
  monitorSizeId String      @db.Uuid
  conditionId   String      @db.Uuid
  classrooms    Classroom[]
  brand         Brand       @relation(fields: [brandId], references: [id])
  condition     Condition   @relation(fields: [conditionId], references: [id])
  monitorSize   MonitorSize @relation(fields: [monitorSizeId], references: [id])
  monitorType   MonitorType @relation(fields: [monitorTypeId], references: [id])

  @@map("digital_blackboards")
  @@schema("inventory")
}

model ClassroomDepartment {
  id           String     @id @default(uuid()) @db.Uuid
  classroomId  String     @db.Uuid
  departmentId String     @db.Uuid
  createdAt    DateTime   @default(now())
  classroom    Classroom  @relation(fields: [classroomId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([classroomId, departmentId])
  @@map("classrooms_departments")
  @@schema("infraestructure")
}

model Classroom {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  desks                Int
  tables               Int
  powerOutlets         Int
  lights               Int
  blackboards          Int
  lecterns             Int
  windows              Int
  buildingId           String                @db.Uuid
  roomTypeId           String                @db.Uuid
  connectivityId       String?               @db.Uuid
  audioEquipmentId     String?               @db.Uuid
  projectors           Int
  conditionId          String?               @db.Uuid
  maxCapacity          Int?
  activeStatus         Boolean               @default(true)
  digitalBlackboardId  String?               @db.Uuid
  courseClassrooms     CourseClassroom[]
  audioEquipment       AudioEquipment?       @relation(fields: [audioEquipmentId], references: [id])
  building             Building              @relation(fields: [buildingId], references: [id])
  condition            Condition?            @relation(fields: [conditionId], references: [id])
  connectivity         Connectivity?         @relation(fields: [connectivityId], references: [id])
  digitalBlackboard    DigitalBlackboard?    @relation(fields: [digitalBlackboardId], references: [id])
  roomType             RoomType              @relation(fields: [roomTypeId], references: [id])
  classroomDepartments ClassroomDepartment[]
  airConditioners      AirConditioner[]
  pcEquipments         PcEquipment[]
  classroomInfoView    ClassroomInfoView?

  @@map("classrooms")
  @@schema("infraestructure")
}

model RoomType {
  id          String      @id @default(uuid()) @db.Uuid
  description String
  classrooms  Classroom[]

  @@map("room_types")
  @@schema("infraestructure")
}

model Connectivity {
  id          String      @id @default(uuid()) @db.Uuid
  description String
  classrooms  Classroom[]

  @@map("connectivities")
  @@schema("inventory")
}

model AudioEquipment {
  id          String      @id @default(uuid()) @db.Uuid
  description String
  classrooms  Classroom[]

  @@map("audio_equipments")
  @@schema("inventory")
}

model Brand {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  airConditioners    AirConditioner[]
  digitalBlackboards DigitalBlackboard[]
  pcEquipments       PcEquipment[]

  @@map("brands")
  @@schema("inventory")
}

model Condition {
  id                 String              @id @default(uuid()) @db.Uuid
  status             String
  Classroom          Classroom[]
  airConditioners    AirConditioner[]
  digitalBlackboards DigitalBlackboard[]
  pcEquipments       PcEquipment[]

  @@map("conditions")
  @@schema("inventory")
}

model AirConditioner {
  id          String     @id @default(uuid()) @db.Uuid
  description String?
  brandId     String     @db.Uuid
  conditionId String     @db.Uuid
  classroomId String?    @db.Uuid
  brand       Brand      @relation(fields: [brandId], references: [id])
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  condition   Condition  @relation(fields: [conditionId], references: [id])

  @@map("air_conditioners")
  @@schema("inventory")
}

model PcEquipment {
  id              String      @id @default(uuid()) @db.Uuid
  inventoryNumber String
  processor       String
  ram             String
  disk            String
  brandId         String      @db.Uuid
  conditionId     String      @db.Uuid
  monitorTypeId   String      @db.Uuid
  monitorSizeId   String      @db.Uuid
  pcTypeId        String      @db.Uuid
  departmentId    String?     @db.Uuid
  classroomId     String?     @db.Uuid
  brand           Brand       @relation(fields: [brandId], references: [id])
  classroom       Classroom?  @relation(fields: [classroomId], references: [id])
  condition       Condition   @relation(fields: [conditionId], references: [id])
  monitorSize     MonitorSize @relation(fields: [monitorSizeId], references: [id])
  monitorType     MonitorType @relation(fields: [monitorTypeId], references: [id])
  pcType          PcType      @relation(fields: [pcTypeId], references: [id])

  @@map("pc_equipments")
  @@schema("inventory")
}

model MonitorType {
  id                 String              @id @default(uuid()) @db.Uuid
  description        String
  digitalBlackboards DigitalBlackboard[]
  pcEquipments       PcEquipment[]

  @@map("monitor_types")
  @@schema("inventory")
}

model MonitorSize {
  id                 String              @id @default(uuid()) @db.Uuid
  description        String
  digitalBlackboards DigitalBlackboard[]
  pcEquipments       PcEquipment[]

  @@map("monitor_sizes")
  @@schema("inventory")
}

model PcType {
  id           String        @id @default(uuid()) @db.Uuid
  description  String
  pcEquipments PcEquipment[]

  @@map("pc_types")
  @@schema("inventory")
}

model CourseClassroom {
  id                       String                    @id @default(uuid()) @db.Uuid
  courseId                 String                    @db.Uuid
  classroomId              String                    @db.Uuid
  studentCount             Int
  modalityId               String                    @db.Uuid
  nearGraduation           Boolean
  groupCode                String                    @default("G1")
  teachingSessionId        String                    @db.Uuid
  days                     String
  section                  String
  observation              String?
  classroom                Classroom                 @relation(fields: [classroomId], references: [id])
  course                   Course                    @relation(fields: [courseId], references: [id])
  modality                 Modality                  @relation(fields: [modalityId], references: [id])
  teachingSession          TeachingSession           @relation(fields: [teachingSessionId], references: [id], onDelete: Cascade)
  courseStadistic          CourseStadistic?
  scheduleComplianceChecks ScheduleComplianceCheck[]

  @@unique([courseId, classroomId, teachingSessionId, groupCode])
  @@map("course_classrooms")
  @@schema("academic")
}

model ScheduleComplianceCheck {
  id                String    @id @default(uuid()) @db.Uuid
  courseClassroomId String    @db.Uuid
  monitorId         String    @db.Uuid
  checkDate         DateTime
  checkTime         String
  isPresent         Boolean
  observation       String?
  offlineId         String?
  syncedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  courseClassroom CourseClassroom @relation(fields: [courseClassroomId], references: [id], onDelete: Cascade)
  monitor         User            @relation(fields: [monitorId], references: [id], onDelete: Restrict)

  @@unique([courseClassroomId, checkDate, checkTime])
  @@index([monitorId, checkDate])
  @@map("schedule_compliance_checks")
  @@schema("academic")
}

model Modality {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique
  courseClassrooms CourseClassroom[]

  @@map("modalities")
  @@schema("academic")
}

model AcademicPeriod {
  id                String                     @id @default(uuid()) @db.Uuid
  year              Int
  pac               Int
  pac_modality      String                     @default("Trimestre")
  startDate         DateTime
  endDate           DateTime
  assignmentReports AcademicAssignmentReport[]

  @@unique([year, pac, pac_modality])
  @@map("academic_periods")
  @@schema("academic")
}

model AcademicAssignmentReport {
  id                      String                  @id @default(uuid()) @db.Uuid
  teacherId               String                  @db.Uuid
  periodId                String                  @db.Uuid
  centerDepartmentId      String                  @db.Uuid
  centerDepartment        CenterDepartment        @relation(fields: [centerDepartmentId], references: [id])
  period                  AcademicPeriod          @relation(fields: [periodId], references: [id])
  teacher                 Teacher                 @relation(fields: [teacherId], references: [id])
  complementaryActivities ComplementaryActivity[]
  teachingSession         TeachingSession?

  @@unique([teacherId, centerDepartmentId, periodId])
  @@map("academic_assignment_reports")
  @@schema("academic")
}

model TeachingSession {
  id                 String                   @id @default(uuid()) @db.Uuid
  consultHour        DateTime?
  tutoringHour       DateTime?
  assignmentReportId String                   @unique @db.Uuid
  courseClassrooms   CourseClassroom[]
  assignmentReport   AcademicAssignmentReport @relation(fields: [assignmentReportId], references: [id], onDelete: Cascade)

  @@map("teaching_sessions")
  @@schema("academic")
}

model CourseStadistic {
  id                String          @id @default(uuid()) @db.Uuid
  APB               Int
  RPB               Int
  NSP               Int
  ABD               Int
  courseClassroomId String          @unique @db.Uuid
  courseClassroom   CourseClassroom @relation(fields: [courseClassroomId], references: [id], onDelete: Cascade)

  @@map("course_staditics")
  @@schema("academic")
}

model ComplementaryActivity {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  isRegistered       Boolean?
  fileNumber         String?
  progressLevel      String
  assignmentReportId String                   @db.Uuid
  activityTypeId     String                   @db.Uuid
  activityType       ActivityType             @relation(fields: [activityTypeId], references: [id])
  assignmentReport   AcademicAssignmentReport @relation(fields: [assignmentReportId], references: [id], onDelete: Cascade)
  verificationMedia  VerificationMedia?

  @@map("complementary_activities")
  @@schema("academic")
}

model ActivityType {
  id                      String                  @id @default(uuid()) @db.Uuid
  name                    String                  @unique
  description             String?
  complementaryActivities ComplementaryActivity[]

  @@map("activity_types")
  @@schema("academic")
}

model VerificationMedia {
  id                     String                  @id @default(uuid()) @db.Uuid
  description            String
  activityId             String                  @unique @db.Uuid
  verificationMediaFiles VerificationMediaFile[]
  complementaryActivity  ComplementaryActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("verification_medias")
  @@schema("academic")
}

model VerificationMediaFile {
  id                  String            @id @default(uuid()) @db.Uuid
  url                 String
  multimediaTypeId    String            @db.Uuid
  verificationMediaId String            @db.Uuid
  public_id           String
  multimediaType      MultimediaType    @relation(fields: [multimediaTypeId], references: [id])
  verificationMedia   VerificationMedia @relation(fields: [verificationMediaId], references: [id], onDelete: Cascade)

  @@map("verification_media_files")
  @@schema("academic")
}

model MultimediaType {
  id                     String                  @id @default(uuid()) @db.Uuid
  description            String                  @unique
  verificationMediaFiles VerificationMediaFile[]

  @@map("multimedia_types")
  @@schema("academic")
}

model ResetPasswordToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  expiryDate DateTime
  userId     String   @db.Uuid
  isActive   Boolean  @default(true)
  user       User     @relation(fields: [userId], references: [id])

  @@map("reset_password_tokens")
  @@schema("auth")
}

model TeacherPreferredClass {
  id        String  @id @default(uuid()) @db.Uuid
  courseId  String  @db.Uuid
  teacherId String  @db.Uuid
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, courseId])
  @@map("teacher_preferred_classes")
  @@schema("ai")
}

view ClassroomInfoView {
  id             String    @unique @db.Uuid
  normalizedName String?
  classroom      Classroom @relation(fields: [id], references: [id])

  @@map("vw_classroom_info")
  @@schema("infraestructure")
}
